# =======================================================
# THE CROWN DANCE STUDIO - CHATBOT ENVIRONMENT VARIABLES
# =======================================================

# URL del webhook seguro en tu servidor n8n
N8N_CROWN_WEBHOOK_URL=https://your-n8n-domain.com/webhook/sample-path

# API Key compartida para autenticar solicitudes entre el proxy y n8n (mínimo 32 caracteres)
N8N_CROWN_API_KEY=your_shared_secret_api_key_sample_value_here

# Secreto para firmar y validar tokens de estado HMAC
CROWN_STATE_SECRET=your_hmac_state_signing_secret_sample_value_here

# Google Gemini API Key (Obtenida en https://aistudio.google.com/)
AI_PROVIDER_API_KEY=your_gemini_api_key_sample_value_here

# Enlace base oficial de WhatsApp
CROWN_WHATSAPP_URL=https://wa.me/your_phone_number_here

# Orígenes permitidos (CORS Whitelist, separados por comas)
CROWN_ALLOWED_ORIGINS=https://your-site-domain.com

# Puerto para el proxy autónomo en Node o Python
PORT=3000

# Entorno de ejecución: 'production' o 'development'
NODE_ENV=production
