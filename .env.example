# =======================================================
# THE CROWN DANCE STUDIO - CHATBOT ENVIRONMENT VARIABLES
# =======================================================

# URL del webhook seguro en tu servidor n8n
N8N_CROWN_WEBHOOK_URL=https://n8n.dupixelcode.com/webhook/crown-chat-v1

# API Key compartida para autenticar solicitudes entre el proxy y n8n (mínimo 32 caracteres)
# Ejemplo: openssl rand -hex 32
N8N_CROWN_API_KEY=crown_sec_live_9a7b3c2d1e4f5a6b7c8d9e0f1a2b3c4d5e

# Secreto para firmar y validar tokens de estado HMAC (previene manipulación de sesión/consentimiento)
# Ejemplo: openssl rand -hex 32
CROWN_STATE_SECRET=crown_state_secret_84f93b2a1c0d4e5f6a7b8c9d0e1f2a3b

# Google Gemini API Key (Obtenida en https://aistudio.google.com/)
# Ejemplo: AIzaSy...
AI_PROVIDER_API_KEY=AIzaSy_tu_gemini_api_key_aqui

# Enlace base oficial de atención humana en WhatsApp (52 442 236 6997)
CROWN_WHATSAPP_URL=https://wa.me/524422366997

# Orígenes permitidos (CORS Whitelist, separados por comas)
CROWN_ALLOWED_ORIGINS=https://thecrowndancestudio.com,https://www.thecrowndancestudio.com,https://n8n.dupixelcode.com,http://localhost:8080,http://127.0.0.1:8080

# Puerto para el proxy autónomo en Node o Python (opcional si se usa Netlify Functions)
PORT=3000

# Entorno de ejecución: 'production' o 'development'
NODE_ENV=production
